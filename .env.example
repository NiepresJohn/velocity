# Copy to .env. Never commit the real file.
DATABASE_URL=postgresql://velocity:velocity@localhost:5432/velocity
# 32+ chars. Dev placeholder; generate a real one: openssl rand -hex 32
SESSION_SECRET=change-me-dev-only-0123456789abcdef0123
APP_URL=http://localhost:3000
NODE_ENV=development
SESSION_COOKIE_NAME=velocity_session
WORKSPACE_COOKIE_NAME=velocity_workspace
# smtp | log | none
EMAIL_PROVIDER=log
# EMAIL_FROM=velocity@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
DB_POOL_MAX=10
