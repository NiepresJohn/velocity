# Copy to .env.production. Never commit the real file.
DOMAIN=velocity.example.com
APP_URL=https://velocity.example.com
POSTGRES_PASSWORD=change-me-long-random
# 32+ random chars: openssl rand -hex 32
SESSION_SECRET=change-me
NODE_ENV=production
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@velocity.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
DB_POOL_MAX=10
